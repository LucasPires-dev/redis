VITE_API_URL=http://127.0.0.1:8001

# Testando contra o backend rodando no servidor de teste da rede local (via
# docker-compose.yml ou swarm-stack.yml do redis-api, publicado na porta
# 8090): troque pelo IP do servidor, ex:
# VITE_API_URL=http://192.168.1.50:8090
# O WebSocket (tempo real) usa a mesma URL trocando http(s) por ws(s) —
# não precisa de variável separada. Esse IP também precisa estar no
# ALLOWED_HOSTS/CORS_ALLOW_ALL_ORIGINS do backend (veja .env.example do
# redis-api).
